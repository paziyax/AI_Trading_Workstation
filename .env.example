# FinAlly environment template.
# Copy to .env and edit:
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
# .env is gitignored; never commit real keys. The start scripts pass this file
# to the container with `docker run --env-file .env` (or docker compose).

# --- LLM -------------------------------------------------------------------
# Required for live AI chat. Leave empty only when LLM_MOCK=true.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# true = deterministic mock responses, zero network calls (E2E tests / offline dev).
LLM_MOCK=false

# LiteLLM model string and OpenRouter provider order.
LLM_MODEL=openrouter/openai/gpt-oss-120b
LLM_PROVIDER=cerebras

# Per-request timeout for LLM calls, in seconds.
LLM_TIMEOUT_SECONDS=30

# --- Market data -----------------------------------------------------------
# Empty MASSIVE_API_KEY = built-in GBM simulator (recommended for most users).
# With a key, real data is polled from Massive (Polygon.io).
MASSIVE_API_KEY=
# auto | massive | simulator. `massive` without a key is an error.
MARKET_DATA_SOURCE=auto
# Massive plan tier: basic has no snapshot entitlement (end-of-day data only).
MASSIVE_PLAN=basic

# --- Runtime ---------------------------------------------------------------
# Container-internal paths. Keep these values when running through Docker.
FINALLY_DB_PATH=/app/db/finally.db
STATIC_DIR=/app/static

# Starting cash for a fresh database. Seeded once; existing data is not topped up.
INITIAL_CASH=10000

# Portfolio snapshot cadence for the P&L chart, in seconds.
SNAPSHOT_INTERVAL_SECONDS=30

# Host port published by the start scripts (default 8000). The container itself
# always listens on 8000. To publish a different host port, export FINALLY_PORT
# in your shell before running a start script.
FINALLY_PORT=8000
