{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["planning/PLAN.md"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "massive": {
        "type": "local",
        "command": [
          "mcp_massive"
        ],
        "environment": {
          "MASSIVE_API_KEY": "{env:MASSIVE_API_KEY}"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      }
    }
  },
  "plugins": ["dezign0"]
}
